# DocuMind AI Environment Configuration
PROJECT_NAME="DocuMind AI"
VERSION="1.0.0"

# Security
SECRET_KEY="documind-secure-jwt-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default, switch to postgresql://user:pass@localhost:5432/documind if desired)
DATABASE_URL="sqlite:///./documind.db"
STORAGE_DIR="./storage/documents"

# Google Gemini API (Optional: Leave empty for offline deterministic RAG mode)
GEMINI_API_KEY=""
EMBEDDING_MODEL="text-embedding-004"
GENERATION_MODEL="gemini-1.5-flash"

# Constraints
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
